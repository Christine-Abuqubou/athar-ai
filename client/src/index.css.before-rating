  font-size: 12px;
}

.inner-intro p,
.hero-lede,
.story-copy p,
.section-head p,
.light-head p,
.sources-head p,
.explore-cta p {
  font-size: 20px;
  line-height: 1.65;
}

.site-card h3 {
  font-size: 27px;
}

.site-card p {
  font-size: 17px;
}

.detail-hero-copy h2 {
  font-size: 56px;
}

.detail-hero-copy p {
  font-size: 16px;
}

.detail-tabs button {
  font-size: 15px;
  font-weight: 700;
}

.detail-content p {
  font-size: 18px;
  line-height: 1.7;
}

.detail-copy-grid h3,
.history-intro h3,
.audio-copy h3,
.ask-header h3 {
  font-size: 32px;
}

.document-card b,
.document-card span {
  font-size: 16px;
}

.era-options button {
  font-size: 14px;
  font-weight: 700;
}

.footer-top,
.footer-bottom {
  font-size: 15px;
}

@media (max-width: 900px) {
  body {
    font-size: 16px;
  }

  p {
    font-size: 17px;
  }

  .desktop-nav {
    display: none;
  }

  .inner-intro p,
  .hero-lede,
  .story-copy p,
  .section-head p,
  .light-head p,
  .sources-head p,
  .explore-cta p {
    font-size: 18px;
  }

  .detail-hero-copy h2 {
    font-size: 40px;
  }

  .detail-tabs button {
    font-size: 13px;
  }

  .detail-content p {
    font-size: 17px;
  }
}

