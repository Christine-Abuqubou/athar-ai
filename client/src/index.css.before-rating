/* Bigger and bolder navbar text */
.desktop-nav a {
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.03em;
}

.header-scan {
  font-size: 14px;
  font-weight: 700;
}

.lang-toggle {
  font-size: 14px;
  font-weight: 700;
}

/* Full-page heritage detail experience */
.detail-overlay {
  padding: 0;
  place-items: stretch;
}

.detail-sheet {
  width: 100%;
  max-width: none;
  height: 100vh;
  min-height: 100vh;
  margin: 0;
  border-radius: 0;
}


/* Show the complete heritage image in the detail hero */
.detail-hero {
  height: 430px;
  background: #20251f;
}

.detail-hero img {
  object-fit: contain;
  background: #20251f;
}


/* Full-width heritage hero image without cropping */
.detail-hero {
  width: 100%;
  height: auto;
  min-height: 0;
  background: #20251f;
  overflow: hidden;
}

.detail-hero img {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
}


/* Al-Aqsa heritage page background */
.detail-sheet {
  background:
    radial-gradient(circle at 15% 10%, rgba(184, 145, 73, 0.12), transparent 32%),
    radial-gradient(circle at 85% 70%, rgba(72, 88, 68, 0.10), transparent 34%),
    #e9e0cc;
}

.detail-content {
  background: #e9e0cc;
}

.detail-tabs {
  background: #ded3bd;
}

.detail-source-bar {
  background: #d8ccb4;
}


/* Powerful Explore page atmosphere */
.explore-page {
  position: relative;
  isolation: isolate;
  background:
    linear-gradient(135deg, rgba(19, 25, 21, 0.97), rgba(48, 42, 29, 0.94)),
    url("/media/old-city.jpg") center / cover fixed;
  color: #f7f0df;
  overflow: hidden;
}

.explore-page::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(circle at 12% 18%, rgba(224, 183, 102, 0.26), transparent 28%),
    radial-gradient(circle at 88% 72%, rgba(106, 132, 94, 0.20), transparent 34%),
    linear-gradient(90deg, rgba(10, 14, 12, 0.42), transparent 45%, rgba(10, 14, 12, 0.38));
  pointer-events: none;
}

.explore-page .inner-intro {
  position: relative;
  padding-top: 130px;
  padding-bottom: 90px;
}

.explore-page .inner-intro h1 {
  color: #fff8e9;
  text-shadow: 0 5px 28px rgba(0, 0, 0, 0.35);
}

.explore-page .inner-intro p {
  color: rgba(255, 248, 233, 0.76);
  max-width: 620px;
}

.explore-page .status-pill {
  background: rgba(213, 169, 84, 0.17);
  border-color: rgba(231, 194, 115, 0.7);
  color: #e8c77d;
}

.explore-page .explore-page-grid {
  position: relative;
  padding-bottom: 110px;
}

.explore-page .site-card {
  background: rgba(250, 244, 230, 0.96);
  box-shadow:
    0 22px 55px rgba(0, 0, 0, 0.28),
    0 0 0 1px rgba(232, 199, 125, 0.22);
  transition: transform 220ms ease, box-shadow 220ms ease;
}

.explore-page .site-card:hover {
  transform: translateY(-10px);
  box-shadow:
    0 34px 70px rgba(0, 0, 0, 0.38),
    0 0 0 1px rgba(232, 199, 125, 0.65);
}

.explore-page .site-card-image-wrap {
  border-bottom: 3px solid #c99e51;
}

.explore-page .explore-cta {
  background:
    linear-gradient(120deg, rgba(20, 27, 22, 0.96), rgba(76, 61, 34, 0.96)),
    url("/media/dome-of-rock.jpg") center / cover;
  color: #fff8e9;
  border: 1px solid rgba(231, 194, 115, 0.58);
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);
}

.explore-page .explore-cta p,
.explore-page .explore-cta span {
  color: rgba(255, 248, 233, 0.72);
}

@media (max-width: 900px) {
  .explore-page {
    background-attachment: scroll;
  }

  .explore-page .inner-intro {
    padding-top: 95px;
    padding-bottom: 58px;
  }

  .explore-page .explore-page-grid {
    padding-bottom: 70px;
  }
}


/* Global larger and more readable typography */
body {
  font-size: 17px;
}

p {
  font-size: 18px;
  line-height: 1.7;
}

button,
input,
textarea,
select {
  font-size: 16px;
}

.desktop-nav a {
  font-size: 16px;
  font-weight: 700;
}

.brand-copy b {
  font-size: 17px;
  font-weight: 800;
}

.brand-copy small {
  font-size: 11px;
}

.header-scan {
  font-size: 15px;
  font-weight: 700;
}

.eyebrow,
.story-kicker,
.section-number,
.media-label,
.status-pill,
.map-city,
