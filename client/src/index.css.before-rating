.era-lens { display: flex; align-items: end; justify-content: space-between; gap: 25px; margin-bottom: 22px; padding: 18px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }.era-lens h3 { font-family: 'Playfair Display', serif; font-size: 27px; font-weight: 500; margin: 9px 0 0; }.era-options { display: flex; gap: 6px; flex-wrap: wrap; justify-content: end; }.era-options button { border: 1px solid var(--line); background: transparent; color: var(--muted); padding: 9px 11px; font-size: 10px; }.era-options button:hover, .era-options button.active { background: var(--ink); color: #fff; border-color: var(--ink); }.past-video > video { width: 100%; height: 100%; object-fit: cover; background: #111; }.past-video > video + .past-video-wash, .video-caption { pointer-events: none; }
