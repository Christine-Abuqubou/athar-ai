              <iframe title="Jerusalem walking route map" src={mapUrl} loading="lazy" />
              <div className="route-line" />
              {stops.map((stop, index) => (
                <div key={stop.name} className={`route-marker route-marker-${index + 1}`}>
                  <b>{index + 1}</b>
