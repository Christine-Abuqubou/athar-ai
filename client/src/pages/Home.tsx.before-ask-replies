function WebsiteRating() {
  const [open, setOpen] = useState(false);
  const [rating, setRating] = useState(() =>
    Number(localStorage.getItem("athar-website-rating") || 0)
  );
  const [feedback, setFeedback] = useState(() =>
    localStorage.getItem("athar-website-feedback") || ""
  );
  const [saved, setSaved] = useState(false);

  const save = () => {
    if (!rating) return;
    localStorage.setItem("athar-website-rating", String(rating));
    localStorage.setItem("athar-website-feedback", feedback);
    setSaved(true);
  };

  return (
    <>
      <button
        className="website-rating-trigger"
        onClick={() => setOpen(true)}
        aria-label="Rate the ATHAR website"
      >
        <span>★</span> Rate ATHAR
      </button>

      {open && (
        <div
          className="website-rating-backdrop"
          onClick={() => setOpen(false)}
        >
          <section
            className="website-rating-panel"
            onClick={event => event.stopPropagation()}
            role="dialog"
            aria-modal="true"
            aria-labelledby="website-rating-title"
          >
            <button
              className="website-rating-close"
              onClick={() => setOpen(false)}
              aria-label="Close rating"
            >
              ×
            </button>

            <p className="eyebrow">Your feedback matters</p>
            <h2 id="website-rating-title">
              How was your ATHAR experience?
            </h2>

            <p className="website-rating-intro">
              Rate the whole website: exploration, stories, videos, navigation,
              and design.
            </p>

            <div className="website-stars" aria-label="Rate from 1 to 5 stars">
              {[1, 2, 3, 4, 5].map(value => (
                <button
                  key={value}
                  type="button"
                  className={value <= rating ? "selected" : ""}
                  onClick={() => {
                    setRating(value);
                    setSaved(false);
                  }}
                  aria-label={value + " stars"}
                >
                  ★
                </button>
              ))}
            </div>

            <textarea
              value={feedback}
              onChange={event => {
                setFeedback(event.target.value);
                setSaved(false);
              }}
              placeholder="Tell us what you liked or what we can improve..."
              aria-label="Website feedback"
            />

            <button
              className="button button-dark website-rating-save"
              onClick={save}
              disabled={!rating}
            >
              {saved ? "Thank you - rating saved" : "Submit website rating"}
            </button>
          </section>
        </div>
      )}
    </>
  );
}

