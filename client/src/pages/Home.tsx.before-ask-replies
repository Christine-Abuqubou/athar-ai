function ScanExperience({ close }: { close: () => void }) {
  const videoRef = useRef<HTMLVideoElement>(null);
  const [streaming, setStreaming] = useState(false);
  const [permissionError, setPermissionError] = useState(false);
  const [demoFound, setDemoFound] = useState(false);
  useEffect(() => {
    let stream: MediaStream | undefined;
    navigator.mediaDevices?.getUserMedia({ video: { facingMode: { ideal: "environment" } }, audio: false }).then(value => { stream = value; setStreaming(true); if (videoRef.current) videoRef.current.srcObject = value; }).catch(() => setPermissionError(true));
    return () => stream?.getTracks().forEach(track => track.stop());
  }, []);
  return <div className="scan-overlay"><div className="scan-modal"><div className="scan-top"><div><StatusPill tone="light">{demoFound ? "Demo match found" : "Demo mode · visual recognition"}</StatusPill><h2>{demoFound ? "You discovered:" : "Scan a Jerusalem site"}</h2>{demoFound && <h3>Dome of the Rock <span>قبة الصخرة</span></h3>}</div><button className="icon-button light" onClick={close} aria-label="Close scanner"><X size={22} /></button></div>{demoFound ? <div className="scan-result"><img src={IMG.dome} alt="Dome of the Rock" /><div className="scan-result-copy"><p className="eyebrow">Umayyad Jerusalem · 691 CE</p><p>Recognition is running in demo mode. This result is a guided prototype, not live computer vision.</p><div className="scan-result-actions"><Link href="/site/dome-of-the-rock" className="button button-gold" onClick={close}>Explore the site <ArrowRight size={16} /></Link><button className="button button-outline-light" onClick={() => setDemoFound(false)}>Scan again</button></div></div></div> : <><div className="camera-frame"><video ref={videoRef} autoPlay muted playsInline /><div className="camera-vignette" /><div className="scan-corners" /><div className="scan-beam" /><div className="camera-status">{permissionError ? <><Camera size={16} /> Camera access is required to scan a site.</> : streaming ? <><Radio size={16} /> Move closer to a heritage marker</> : <><LoaderIcon /> Preparing camera…</>}</div></div><div className="scan-controls"><button className="icon-button light"><Sun size={18} /></button><button className="scan-shutter" onClick={() => setDemoFound(true)} aria-label="Scan"><span><Camera size={24} /></span></button><button className="icon-button light"><RotateIcon /></button></div><div className="scan-disclaimer"><LockKeyhole size={13} /> Your camera stays on your device · Try demo recognition</div></>}</div></div>;
}

