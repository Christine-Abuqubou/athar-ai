  },
  {
    slug: "al-aqsa-mamluk",
    name: "Al-Aqsa in Mamluk Jerusalem",
    arabic: "المسجد الأقصى في القدس المملوكية",
    period: "Mamluk Jerusalem · 13th–15th century",
    category: "Live documentary",
    image: IMG.dome,
    accent: "gold",
    description: "Step into a documentary view of al-Aqsa and Jerusalem during the Mamluk period.",
    fact: "The Mamluk period left a visible architectural and institutional imprint around Jerusalem's sacred plateau.",
    location: "al-Ḥaram al-Sharīf",
  },
  {
