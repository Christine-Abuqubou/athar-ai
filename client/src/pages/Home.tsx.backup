import { useEffect, useMemo, useRef, useState } from "react";
import { Link, useLocation } from "wouter";
import {
  ArrowRight,
  ArrowUpRight,
  BookOpen,
  Camera,
  Check,
  ChevronDown,
  ChevronLeft,
  CircleHelp,
  Clock3,
  Compass,
  FileText,
  Flame,
  Globe2,
  Headphones,
  Languages,
  Layers3,
  Landmark,
  LockKeyhole,
  Map,
  MapPin,
  Menu,
  Mic2,
  Moon,
  Play,
  Radio,
  Route as RouteIcon,
  Search,
  Send,
  ShieldCheck,
  Sparkles,
  Sun,
  Timer,
  UserRound,
  Volume2,
  X,
} from "lucide-react";
import { toast } from "sonner";

const IMG = {
  city: "/media/city-of-david.jpg",
  dome: "/media/dome-of-rock.jpg",
  oldCity: "/media/old-city.jpg",
  heritage: "/media/islamic-heritage.jpg",
};const VIDEO = {
  mamluk: "/media/mamluk-jerusalem-complete.mp4",
  westernWallOttoman: "/media/western-wall-ottoman.mp4",
  constantinian: "/media/constantinian-jerusalem-documentary.mp4",
};





type Site = {
  slug: string;
  name: string;
  arabic: string;
  period: string;
  category: string;
  image: string;
  accent: string;
  description: string;
  fact: string;
  location: string;
};

const SITES: Site[] = [
  {
    slug: "dome-of-the-rock",
    name: "Dome of the Rock",
    arabic: "قبة الصخرة",
    period: "Umayyad Jerusalem · 691 CE",
    category: "Architecture",
    image: IMG.dome,
    accent: "gold",
    description: "A luminous octagonal sanctuary at the heart of Jerusalem's sacred plateau.",
    fact: "Its foundation inscription is among the earliest surviving examples of monumental Islamic epigraphy.",
    location: "Temple Mount / al-Ḥaram al-Sharīf",
  },
  {
    slug: "city-of-david",
    name: "City of David",
    arabic: "مدينة داود",
    period: "Iron Age · c. 1000 BCE",
    category: "Archaeology",
    image: IMG.city,
    accent: "clay",
    description: "The ridge where layers of settlement trace Jerusalem's earliest urban stories.",
    fact: "The ancient ridge is associated with the oldest continuously inhabited core of Jerusalem.",
    location: "Silwan ridge",
  },
  {
    slug: "old-city-walls",
    name: "Old City Walls",
    arabic: "أسوار البلدة القديمة",
    period: "Ottoman Jerusalem · 1538–1541",
    category: "History",
    image: IMG.oldCity,
    accent: "olive",
    description: "A 16th-century city wall that still frames movement through Jerusalem today.",
    fact: "The present walls were commissioned during the reign of Sultan Suleiman the Magnificent.",
