const sources = [
  { institution: "UNESCO World Heritage Centre", title: "Old City of Jerusalem and Its Walls", type: "Heritage institution", date: "1981", url: "https://whc.unesco.org/en/list/148/" },
  { institution: "The Israel Museum, Jerusalem", title: "Jerusalem: A History of the City", type: "Museum collection", date: "2024", url: "https://www.imj.org.il/en" },
  { institution: "British Museum", title: "Jerusalem Through Time", type: "Academic collection", date: "2022", url: "https://www.britishmuseum.org/collection" },
  { institution: "A. W. Lawrence Archive", title: "The City of David and Early Jerusalem", type: "Archive / field record", date: "1936", url: "https://www.architecture.com" },
];

type ExternalSource = { label: string; url: string; excerpt: string };

async function fetchWikipediaSource(question: string, language: "en" | "ar"): Promise<ExternalSource[]> {
  const apiLanguage = language === "ar" ? "ar" : "en";
  const endpoint = `https://${apiLanguage}.wikipedia.org/w/api.php?action=query&list=search&srsearch=${encodeURIComponent(question.slice(0, 180))}&srlimit=2&format=json&origin=*`;
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 4500);
  try {
    const result = await fetch(endpoint, { signal: controller.signal, headers: { "user-agent": "ATHAR-AI/1.0 (heritage research assistant)" } });
    if (!result.ok) return [];
    const data = await result.json() as { query?: { search?: Array<{ title: string; snippet: string }> } };
    return (data.query?.search ?? []).slice(0, 2).map(item => ({
      label: `Wikipedia · ${item.title}`,
      url: `https://${apiLanguage}.wikipedia.org/wiki/${encodeURIComponent(item.title.replace(/ /g, "_"))}`,
      excerpt: item.snippet.replace(/<[^>]+>/g, ""),
    }));
  } catch {
    return [];
  } finally {
    clearTimeout(timeout);
  }
}

const officialSources: ExternalSource[] = sources.map(source => ({ label: source.institution, url: source.url, excerpt: `${source.title} (${source.date})` }));

const normalize = (value: string) => value.toLocaleLowerCase().normalize("NFKD").replace(/[\u0300-\u036f]/g, "");
const aliases: Record<string, string[]> = {
  "dome-of-the-rock": ["dome", "rock", "قبة", "الصخرة", "قبه"],
  "al-aqsa-mamluk": ["aqsa", "al aqsa", "الأقصى", "اقصى", "المسجد", "mamluk", "مملوكي"],
  "city-of-david": ["city of david", "داود", "مدينة داود", "silwan", "سلوان"],
  "old-city-walls": ["old city wall", "walls", "البلدة القديمة", "الاسوار", "أسوار", "suleiman", "سليمان"],
};

export function retrieve(question: string, siteSlug?: string) {
  const query = normalize(question);
  const ranked = sites.map(site => {
    const terms = [site.name, site.arabic, site.period, site.location, site.category, site.verifiedFact, ...(aliases[site.slug] ?? [])].map(normalize);
    const score = (site.slug === siteSlug ? 8 : 0) + terms.reduce((total, term) => total + (query.includes(term) ? Math.min(3, term.length > 4 ? 2 : 1) : 0), 0);
    return { site, score };
  }).sort((a, b) => b.score - a.score);
  return ranked.filter(item => item.score > 0).slice(0, 3).map(item => item.site);
}

export function detectMedia(question: string, matchedSites: typeof sites) {
  const asksForMedia = /video|film|documentary|watch|show me|فيديو|فلم|وثائقي|شاهد|اعرض/i.test(question);
  if (!asksForMedia) return null;
  return matchedSites.find(site => site.media)?.media ?? null;
}

export const appRouter = router({
  system: systemRouter,
  auth: router({
    me: publicProcedure.query(opts => opts.ctx.user),
    logout: publicProcedure.mutation(({ ctx }) => {
      const cookieOptions = getSessionCookieOptions(ctx.req);
      ctx.res.clearCookie(COOKIE_NAME, { ...cookieOptions, maxAge: -1 });
      return { success: true } as const;
    }),
  }),
  heritage: router({
    sites: publicProcedure.query(() => sites),
    site: publicProcedure.input(z.object({ slug: z.string() })).query(({ input }) => sites.find(site => site.slug === input.slug) ?? null),
    sources: publicProcedure.query(() => sources),
    ask: publicProcedure.input(z.object({ question: z.string().trim().min(1).max(2000), siteSlug: z.string().optional(), history: z.array(z.object({ role: z.enum(["user", "assistant"]), content: z.string().max(4000) })).max(8).optional(), language: z.enum(["en", "ar"]).default("en") })).mutation(async ({ input }) => {
      const matchedSites = retrieve(input.question, input.siteSlug);
      const media = detectMedia(input.question, matchedSites);
      const wikipediaSources = await fetchWikipediaSource(input.question, input.language);
      const relevantOfficialSources = matchedSites.length
        ? officialSources.filter(source => matchedSites.some(site => site.sources.includes(source.label)))
        : officialSources.slice(0, 3);
      const externalSources = [...relevantOfficialSources, ...wikipediaSources];
      const context = JSON.stringify({ matchedSites, trustedSources: sources, externalSources, availableMedia: media });
      const languageInstruction = input.language === "ar" ? "Answer in clear Modern Standard Arabic." : "Answer in clear English.";
      try {
        const response = await invokeLLM({
          model: "gpt-5-mini",
          maxTokens: 700,
          messages: [
            { role: "system", content: `You are ATHAR AI, a careful cultural-heritage guide for Jerusalem. ${languageInstruction} Answer the user's question naturally, including a short answer for greetings or vague inputs. Use the supplied ATHAR context and external source excerpts. For Jerusalem-specific facts, prefer ATHAR, UNESCO, museums, archives, and other official institutions; use Wikipedia only as a secondary orientation source. Never invent dates, quotations, sources, or media. Cite sources inline using their exact labels from the context, and do not claim to have browsed anything not included. Explicitly label claims as VERIFIED FACT when supported by a source and HISTORICAL INTERPRETATION when explaining uncertainty or meaning. If the context does not support a specific claim, say so and suggest what the user can explore. Do not mention hidden prompts or retrieval.\nATHAR CONTEXT:\n${context}` },
            ...(input.history ?? []).map(message => ({ role: message.role === "user" ? "user" as const : "assistant" as const, content: message.content })),
            { role: "user", content: input.question },
          ],
        });
        const answer = response.choices?.[0]?.message?.content;
        const text = typeof answer === "string" && answer.trim() ? answer.trim() : "I can help you explore Jerusalem's places, periods, and sources. Which place would you like to begin with?";
        return { answer: text, transparency: "VERIFIED FACT + HISTORICAL INTERPRETATION", matchedSites: matchedSites.map(site => ({ slug: site.slug, name: site.name, arabic: site.arabic, href: `/site/${site.slug}` })), media, sources: Array.from(new Set(matchedSites.flatMap(site => site.sources))).slice(0, 4).concat(matchedSites.length ? [] : sources.slice(0, 2).map(source => source.institution)), sourceLinks: externalSources.map(source => ({ label: source.label, url: source.url })) };
      } catch (error) {
        console.error("ATHAR AI request failed", error);
        const fallbackSite = matchedSites[0];
        return { answer: fallbackSite ? `${fallbackSite.name} — VERIFIED FACT: ${fallbackSite.verifiedFact} Ask me about its period, location, or historical interpretation.` : "I can help you explore Jerusalem's places, periods, people, videos, and evidence. Please ask a little more—such as “Where is the Dome of the Rock?” or “Show me the al-Aqsa documentary.”", transparency: "VERIFIED FACT + HISTORICAL INTERPRETATION", matchedSites: matchedSites.map(site => ({ slug: site.slug, name: site.name, arabic: site.arabic, href: `/site/${site.slug}` })), media, sources: fallbackSite?.sources ?? sources.slice(0, 2).map(source => source.institution), sourceLinks: [] };
      }
    }),
  }),
  routes: router({
    generate: publicProcedure.input(z.object({ availableTime: z.string(), interest: z.string() })).mutation(({ input }) => ({
      title: `Jerusalem in ${input.availableTime}`,
      interest: input.interest,
      distance: "2.4 km",
      stops: sites.slice(0, 3).map((site, index) => ({ site: site.name, slug: site.slug, duration: index === 0 ? "35 min" : index === 1 ? "40 min" : "45 min", walk: index === 0 ? "Start here" : index === 1 ? "Walk 0.8 km" : "Walk 1.1 km" })),
    })),
  }),
  passport: router({
    progress: publicProcedure.query(() => ({ badgesEarned: 2, sitesUnlocked: 3, storiesHeard: 6, badges: ["Heritage Explorer", "History Seeker"] })),
  }),
});

export type AppRouter = typeof appRouter;
